            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Idempotent MongoDB bulk upsert"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Then Redis XACK"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Duplicate callback execution is still possible"
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
