      "props": {
        "color": "grey",
        "size": "m",
        "w": 1450,
        "font": "sans",
        "textAlign": "start",
        "autoSize": false,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Configure minIdle above expected health processing, queue waiting and MongoDB latency."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "A slow write can outlive minIdle and cause another worker to reclaim the same entry."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "An offline HLS result (status 0) is a monitoring observation to persist, not a handler failure."
                }
              ]
            }
          ]
        }
      },
      "typeName": "shape"
    },
