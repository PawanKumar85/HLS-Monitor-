# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required. No default: the server will not start without it. Generate: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB Configuration
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# Required (or set MONGO_URI). No default credentials.
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=kafka_mimic
# MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/kafka_mimic?authSource=admin

# Server Configuration
PORT=3000
HOST=0.0.0.0
# Set only when GATE runs behind a reverse proxy / API gateway: that proxy's IPs or CIDRs, comma-separated.
# Never a wildcard: a trusted X-Forwarded-For from anyone would let clients pick their own IP.
TRUST_PROXY=

# Signs the login session cookie. 32+ random characters; changing it signs everyone out. Generate: openssl rand -hex 32
SESSION_SECRET=

# Web Push background alerts (free, self-hosted). Leave the keys empty: a pair is generated once and kept in MongoDB.
# To set your own: npx web-push generate-vapid-keys. VAPID_SUBJECT is a contact the push services can reach.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# Docker Compose host port for the combined frontend/backend (container always listens on 3000).
# APP_PORT=3000
