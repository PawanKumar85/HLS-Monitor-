{
  "name": "kafka-mimic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run web:build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p frontend",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 node --import tsx --test tests/integration/*.test.ts",
    "user": "tsx src/cli/user.ts",
    "web:dev": "vite frontend",
    "web:build": "tsc -p frontend && vite build frontend",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/passport": "^4.0.4",
    "@fastify/session": "^11.1.6",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@scalar/fastify-api-reference": "^1.78.0",
    "@xyflow/react": "^12.12.1",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "mongodb": "^7.8.0",
    "passport-local": "^1.0.0",
    "react-router-dom": "^7.18.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.7"
  }
}
